# MLflow tracking configuration.
# Copy to mlflow.env (gitignored) and edit:
#
#     cp mlflow.env.example mlflow.env
#
# Precedence: CLI flags > environment variables > this file > code defaults.
# Empty values below are commented out; uncomment and fill in as needed.

# Local default: SQLite store (./mlflow.db when run from the repo root).
# Comment this out to fall back to the code default (<repo>/mlflow.db).
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=enveda-casmi26

# Remote MLflow server: replace the local URI above with your server URL and
# set an API token. Basic auth also works via MLFLOW_TRACKING_USERNAME and
# MLFLOW_TRACKING_PASSWORD.
# MLFLOW_TRACKING_URI=https://mlflow.example.com
# MLFLOW_TRACKING_TOKEN=

# Artifacts on s3:// stores use boto3. Credentials come from the standard AWS
# profile or AWS_* variables (environment or this file). Set the endpoint for
# non-AWS S3 implementations:
# MLFLOW_S3_ENDPOINT_URL=https://s3.example.com
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=
# MLFLOW_S3_ENDPOINT_URL=https://object.storage.eu01.onstackit.cloud/
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

